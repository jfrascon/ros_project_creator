#!/usr/bin/env bash

# Undefined variables and failed pipelines are errors. Individual commands are
# checked explicitly below so their failure messages identify the real action.
set -uo pipefail

script_name="$(basename "$0")"
image_name='{{ image_name }}'

usage() {
    cat <<EOF
Usage:
  ${script_name} [--up|--down] [options]

Description:
  Start or stop this Docker Compose devcontainer project. Without flags, --up is used.

Options:
  --up        Write .env next to this script and start the compose project. Default.
  --down      Stop the compose project using the existing .env next to this script.
  -h, --help  Show this help message.
EOF
}

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%d_%H-%M-%S')" "$*"; }

require_env() {
    local name="$1"
    # ${!name} is indirect expansion: it reads the variable whose name is
    # stored in name. This lets one small function validate DISPLAY and any
    # future required host variable without using eval.
    local value="${!name:-}"
    if [ -z "${value}" ]; then
        log "ERROR: Required environment variable ${name} is not set or is empty. Export it before running ${script_name} --up."
        exit 1
    fi
}

resolve_render_gid() {
    local render_device="${RENDER_DEVICE:-}"

    if [ -z "${render_device}" ]; then
        render_device="$(
            if [ -d /dev/dri ]; then
                find /dev/dri -maxdepth 1 -type c -name 'renderD*' 2>/dev/null | sort | head -n 1
            fi
        )"

        if [ -z "${render_device}" ]; then
            log "ERROR: No DRM render device found under /dev/dri. Set RENDER_DEVICE=/path/to/renderD* or adapt docker-compose-dev.yaml for a headless setup."
            exit 1
        fi
    fi

    if [ ! -e "${render_device}" ]; then
        log "ERROR: Render device ${render_device} does not exist. Set RENDER_DEVICE to an existing render device."
        exit 1
    fi

    stat -c '%g' "${render_device}"
}

write_env_var() {
    local name="$1"
    local value="$2"

    if [ -z "${value}" ]; then
        log "ERROR: Refusing to write empty environment variable ${name}."
        exit 1
    fi

    if [[ ${value} == *$'\n'* ]]; then
        log "ERROR: Environment variable ${name} contains a newline and cannot be written to the Compose environment file."
        exit 1
    fi

    printf '%s=%s\n' "${name}" "${value}"
}

run_compose() {
    local action="$1"
    local compose_file="$2"
    local env_file="$3"
    local compose_project_directory="$4"

    if [ ! -f "${compose_file}" ]; then
        log "ERROR: Docker Compose file not found: ${compose_file}"
        exit 1
    fi

    case "${action}" in
    up)
        log "Starting compose project with ${compose_file}"

        if ! docker compose --project-directory "${compose_project_directory}" --env-file "${env_file}" -f "${compose_file}" up -d; then
            log "ERROR: Docker Compose failed to start the Dev Container service."
            exit 1
        fi
        ;;
    down)
        if [ ! -f "${env_file}" ]; then
            log "ERROR: Environment file not found: ${env_file}. Run '${compose_project_directory}/${script_name} --up' first."
            exit 1
        fi

        log "Stopping compose project with ${compose_file}"

        if ! docker compose --project-directory "${compose_project_directory}" --env-file "${env_file}" -f "${compose_file}" down; then
            log "ERROR: Docker Compose failed to stop the Dev Container service."
            exit 1
        fi
        ;;
    *)
        log "ERROR: Unknown compose action: ${action}"
        exit 1
        ;;
    esac
}

UP=0
DOWN=0

SHORT_OPTS="h"
LONG_OPTS="help,up,down"
PARSED_ARGS="$(getopt --options "${SHORT_OPTS}" --longoptions "${LONG_OPTS}" --name "$0" -- "$@")" || {
    usage
    exit 2
}
if ! eval set -- "${PARSED_ARGS}"; then
    log "ERROR: Failed to parse command-line options."
    exit 2
fi

while true; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --up)
        UP=1
        shift
        ;;
    --down)
        DOWN=1
        shift
        ;;
    --)
        shift
        break
        ;;
    *)
        log "ERROR: Unexpected option: $1"
        usage
        exit 2
        ;;
    esac
done

if [ "$#" -ne 0 ]; then
    log "ERROR: Unexpected positional arguments: $*"
    usage
    exit 2
fi

if [ "${UP}" -eq 1 ] && [ "${DOWN}" -eq 1 ]; then
    log "ERROR: --up and --down are mutually exclusive."
    usage
    exit 2
fi

if [ "${UP}" -eq 0 ] && [ "${DOWN}" -eq 0 ]; then
    UP=1
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || {
    log "ERROR: Failed to resolve the directory containing ${script_name}."
    exit 1
}

workspace_dir="$(dirname "${script_dir}")"
compose_file="${script_dir}/docker-compose-dev.yaml"
env_file="${script_dir}/.env"
identity_loader="${script_dir}/robotics_dockers_identity.sh"
identity_helper="${workspace_dir}/docker/robotics_dockers_user_env.py"

if [ ! -f "${identity_loader}" ]; then
    log "ERROR: Image identity loader not found: ${identity_loader}"
    exit 1
fi

# The loader path is calculated from this generated script's location, so
# ShellCheck cannot resolve it while checking the source template.
# shellcheck disable=SC1090
. "${identity_loader}"

# Basic host utilities are expected to exist on the supported Ubuntu systems.
# Docker is checked separately so a missing executable is not reported later as
# a missing image. The second check distinguishes Docker from its Compose plugin.
if ! command -v docker >/dev/null 2>&1; then
    log "ERROR: Docker is not installed or is not available in PATH."
    exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
    log "ERROR: The Docker Compose plugin is not available."
    exit 1
fi

if [ "${UP}" -eq 1 ]; then
    require_env DISPLAY

    if ! load_robotics_dockers_image_identity "${image_name}" "${identity_helper}"; then
        log "ERROR: Could not read the development identity from Docker image ${image_name}."
        exit 1
    fi

    host_xauthority_file="${HOST_XAUTHORITY_FILE:-/run/user/$(id -u)/docker-xwayland.xauth}"

    if [ ! -f "${host_xauthority_file}" ]; then
        log "ERROR: XAuthority file not found: ${host_xauthority_file}. Set HOST_XAUTHORITY_FILE to an existing file."
        exit 1
    fi

    render_gid="$(resolve_render_gid)" || {
        log "ERROR: Failed to obtain the render-device GID."
        exit 1
    }

    temporary_env_file="$(mktemp "${env_file}.XXXXXX")" || {
        log "ERROR: Failed to create a temporary environment file next to ${env_file}."
        exit 1
    }

    # -------------------------------------------------------------------------
    # Project-specific Docker Compose environment
    #
    # Add variables required by docker-compose-dev.yaml in this block.
    # Every value written here is available to Compose while it interpolates
    # ${...} expressions in that file.
    # devcont --up replaces .env on every execution, so persistent
    # project-specific values must be defined here or obtained from the host
    # environment here.
    #
    # Example:
    #   write_env_var MY_PROJECT_VARIABLE "${MY_PROJECT_VARIABLE:-default-value}"
    # -------------------------------------------------------------------------
    {
        printf '# Generated by %s --up. Local machine values; do not commit.\n' "${script_name}"
        write_env_var ROBOTICS_DOCKERS_USER_ID "${ROBOTICS_DOCKERS_USER_ID}"
        write_env_var \
            ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID \
            "${ROBOTICS_DOCKERS_USER_PRIMARY_GROUP_ID}"
        write_env_var HOST_ROS_WORKSPACE "${workspace_dir}"
        write_env_var HOST_XAUTHORITY_FILE "${host_xauthority_file}"
        write_env_var RENDER_GID "${render_gid}"
        write_env_var DISPLAY "${DISPLAY}"
    } >"${temporary_env_file}" || {
        rm -f "${temporary_env_file}"
        log "ERROR: Failed to write ${env_file}."
        exit 1
    }

    if ! chmod 600 "${temporary_env_file}"; then
        rm -f "${temporary_env_file}"
        log "ERROR: Failed to make ${env_file} private."
        exit 1
    fi

    if ! mv "${temporary_env_file}" "${env_file}"; then
        rm -f "${temporary_env_file}"
        log "ERROR: Failed to replace ${env_file}."
        exit 1
    fi

    run_compose up "${compose_file}" "${env_file}" "${script_dir}"
else
    run_compose down "${compose_file}" "${env_file}" "${script_dir}"
fi
