#!/usr/bin/env bash

set -euo pipefail

script_name="$(basename "$0")"

usage() {
    cat <<EOF
Usage:
  ${script_name} [--up|--down] [options]

Description:
  Start or stop this Docker Compose devcontainer project. Without flags, --up is used.

Options:
  --up        Write .env next to this script and start the compose project. Default.
  --down      Stop the compose project using the existing .env next to this script.
  -h, --help  Show this help message.
EOF
}

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%d_%H-%M-%S')" "$*"; }

require_cmd() {
    local cmd="$1"
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        log "ERROR: Missing required command: ${cmd}"
        exit 1
    fi
}

require_env() {
    local name="$1"
    local value="${!name:-}"
    if [ -z "${value}" ]; then
        log "ERROR: Required environment variable ${name} is not set or is empty. Export it before running ${script_name} --up."
        exit 1
    fi
}

resolve_render_gid() {
    local render_device="${RENDER_DEVICE:-}"

    if [ -z "${render_device}" ]; then
        render_device="$(
            if [ -d /dev/dri ]; then
                find /dev/dri -maxdepth 1 -type c -name 'renderD*' 2>/dev/null | sort | head -n 1
            fi
        )"

        if [ -z "${render_device}" ]; then
            log "ERROR: No DRM render device found under /dev/dri. Set RENDER_DEVICE=/path/to/renderD* or adapt docker-compose.yaml for a headless setup."
            exit 1
        fi
    fi

    if [ ! -e "${render_device}" ]; then
        log "ERROR: Render device ${render_device} does not exist. Set RENDER_DEVICE to an existing render device."
        exit 1
    fi

    stat -c '%g' "${render_device}"
}

write_env_var() {
    local name="$1"
    local value="$2"

    if [ -z "${value}" ]; then
        log "ERROR: Refusing to write empty environment variable ${name}."
        exit 1
    fi

    if [[ ${value} == *$'\n'* ]]; then
        log "ERROR: Environment variable ${name} contains a newline and cannot be written to ${env_file}."
        exit 1
    fi

    printf '%s=%s\n' "${name}" "${value}"
}

write_env_file() {
    local host_xauthority_file
    local tmp_env_file

    require_cmd id
    require_cmd find
    require_cmd sort
    require_cmd head
    require_cmd stat
    require_cmd mktemp
    require_cmd chmod
    require_cmd mv
    require_env DISPLAY

    host_xauthority_file="${HOST_XAUTHORITY_FILE:-/run/user/$(id -u)/docker-xwayland.xauth}"

    if [ ! -f "${host_xauthority_file}" ]; then
        log "ERROR: XAuthority file not found: ${host_xauthority_file}. Set HOST_XAUTHORITY_FILE to an existing file."
        exit 1
    fi

    tmp_env_file="$(mktemp "${env_file}.XXXXXX")" || {
        log "ERROR: Failed to create a temporary environment file next to ${env_file}."
        exit 1
    }

    {
        printf '# Generated by %s --up. Local machine values; do not commit.\n' "${script_name}"
        write_env_var HOST_UID "$(id -u)"
        write_env_var HOST_UPGID "$(id -g)"
        write_env_var HOST_XAUTHORITY_FILE "${host_xauthority_file}"
        write_env_var RENDER_GID "$(resolve_render_gid)"
        write_env_var DISPLAY "${DISPLAY}"
    } >"${tmp_env_file}" || {
        rm -f "${tmp_env_file}"
        log "ERROR: Failed to write ${env_file}."
        exit 1
    }

    chmod 600 "${tmp_env_file}"
    mv "${tmp_env_file}" "${env_file}"
}

run_compose() {
    local action="$1"

    require_cmd docker

    if [ ! -f "${compose_file}" ]; then
        log "ERROR: Docker Compose file not found: ${compose_file}"
        exit 1
    fi

    if ! docker compose version >/dev/null 2>&1; then
        log "ERROR: Docker Compose plugin is not available. Install Docker Compose or fix your Docker CLI installation."
        exit 1
    fi

    case "${action}" in
    up)
        write_env_file
        log "Starting compose project with ${compose_file}"
        docker compose --project-directory "${script_dir}" --env-file "${env_file}" -f "${compose_file}" up -d
        ;;
    down)
        if [ ! -f "${env_file}" ]; then
            log "ERROR: Environment file not found: ${env_file}. Run '${script_dir}/${script_name} --up' first."
            exit 1
        fi
        log "Stopping compose project with ${compose_file}"
        docker compose --project-directory "${script_dir}" --env-file "${env_file}" -f "${compose_file}" down
        ;;
    *)
        log "ERROR: Unknown compose action: ${action}"
        exit 1
        ;;
    esac
}

require_cmd getopt

UP=0
DOWN=0

SHORT_OPTS="h"
LONG_OPTS="help,up,down"
PARSED_ARGS="$(getopt --options "${SHORT_OPTS}" --longoptions "${LONG_OPTS}" --name "$0" -- "$@")" || {
    usage
    exit 2
}
eval set -- "${PARSED_ARGS}"

while true; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --up)
        UP=1
        shift
        ;;
    --down)
        DOWN=1
        shift
        ;;
    --)
        shift
        break
        ;;
    *)
        log "ERROR: Unexpected option: $1"
        usage
        exit 2
        ;;
    esac
done

if [ "$#" -ne 0 ]; then
    log "ERROR: Unexpected positional arguments: $*"
    usage
    exit 2
fi

if [ "${UP}" -eq 1 ] && [ "${DOWN}" -eq 1 ]; then
    log "ERROR: --up and --down are mutually exclusive."
    usage
    exit 2
fi

if [ "${UP}" -eq 0 ] && [ "${DOWN}" -eq 0 ]; then
    UP=1
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
compose_file="${script_dir}/docker-compose.yaml"
env_file="${script_dir}/.env"

if [ "${UP}" -eq 1 ]; then
    run_compose up
else
    run_compose down
fi
