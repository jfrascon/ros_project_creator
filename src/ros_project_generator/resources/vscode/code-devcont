#!/usr/bin/env bash

# Undefined variables and failed pipelines are errors. Individual commands are
# checked explicitly below so their failure messages identify the real action.
set -uo pipefail

script_name="$(basename "$0")"
image_name='{{ image_name }}'

usage() {
    cat <<EOF
Usage:
  ${script_name} [options]

Description:
  Open this project's VS Code workspace with the environment required by the devcontainer compose file.

Options:
  -h, --help  Show this help message.
EOF
}

log() { printf '[%s] %s\n' "$(date -u +'%Y-%m-%d_%H-%M-%S')" "$*"; }

load_robotics_dockers_image_identity() {
    local image_name="${1}"
    local identity_helper="${2}"
    local image_environment
    local variable_name
    local variable_value

    if [ ! -f "${identity_helper}" ]; then
        log "ERROR: Image identity helper not found: ${identity_helper}"
        return 1
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        log 'ERROR: Python 3 is required to inspect the robotics-dockers image identity.'
        return 1
    fi

    # The Python helper owns the parsing and validation of the image metadata.
    # This launcher only extracts the two generic values required by Compose.
    image_environment="$(python3 "${identity_helper}" "${image_name}")" || return 1

    IMAGE_USER_ID=''
    IMAGE_USER_PRIMARY_GROUP_ID=''
    while IFS='=' read -r variable_name variable_value; do
        case "${variable_name}" in
        IMAGE_USER_ID)
            IMAGE_USER_ID="${variable_value}"
            ;;
        IMAGE_USER_PRIMARY_GROUP_ID)
            IMAGE_USER_PRIMARY_GROUP_ID="${variable_value}"
            ;;
        esac
    done <<<"${image_environment}"

    # The Python helper guarantees decimal values in the supported range. The
    # shell only verifies that its expected output fields were received.
    if [ -z "${IMAGE_USER_ID}" ]; then
        log 'ERROR: Image identity helper returned no IMAGE_USER_ID value.'
        return 1
    fi

    if [ -z "${IMAGE_USER_PRIMARY_GROUP_ID}" ]; then
        log 'ERROR: Image identity helper returned no IMAGE_USER_PRIMARY_GROUP_ID value.'
        return 1
    fi

    export IMAGE_USER_ID
    export IMAGE_USER_PRIMARY_GROUP_ID
}

require_cmd() {
    local cmd="$1"
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        log "ERROR: Missing required command: ${cmd}"
        exit 1
    fi
}

resolve_render_gid() {
    local render_device="${RENDER_DEVICE:-}"

    if [ -z "${render_device}" ]; then
        render_device="$(
            if [ -d /dev/dri ]; then
                find /dev/dri -maxdepth 1 -type c -name 'renderD*' 2>/dev/null | sort | head -n 1
            fi
        )"

        if [ -z "${render_device}" ]; then
            log "ERROR: No DRM render device found under /dev/dri. Set RENDER_DEVICE=/path/to/renderD* or adapt docker-compose-dev.yaml for a headless setup."
            exit 1
        fi
    fi

    if [ ! -e "${render_device}" ]; then
        log "ERROR: Render device ${render_device} does not exist. Set RENDER_DEVICE to an existing render device."
        exit 1
    fi

    stat -c '%g' "${render_device}"
}

SHORT_OPTS="h"
LONG_OPTS="help"
PARSED_ARGS="$(getopt --options "${SHORT_OPTS}" --longoptions "${LONG_OPTS}" --name "$0" -- "$@")" || {
    usage
    exit 2
}
if ! eval set -- "${PARSED_ARGS}"; then
    log "ERROR: Failed to parse command-line options."
    exit 2
fi

while true; do
    case "$1" in
    -h | --help)
        usage
        exit 0
        ;;
    --)
        shift
        break
        ;;
    *)
        log "ERROR: Unexpected option: $1"
        usage
        exit 2
        ;;
    esac
done

if [ "$#" -ne 0 ]; then
    log "ERROR: Unexpected positional arguments: $*"
    usage
    exit 2
fi

# Check only the two external applications that this launcher coordinates.
# Commands such as getopt, id, find, sort, head and stat are normal operating
# system tools. If one of them is missing or fails, its invocation reports the
# problem at the operation that needs it.
require_cmd code
require_cmd docker

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || {
    log "ERROR: Failed to resolve the directory containing ${script_name}."
    exit 1
}
workspace_dir="$(dirname "${script_dir}")"
identity_helper="${workspace_dir}/docker/robotics_dockers_user_env.py"

if [ -z "${DISPLAY:-}" ]; then
    log 'ERROR: Required environment variable DISPLAY is not set or is empty.'
    exit 1
fi

if ! load_robotics_dockers_image_identity "${image_name}" "${identity_helper}"; then
    log "ERROR: Could not read the development identity from Docker image ${image_name}."
    exit 1
fi

host_xauthority_file="${HOST_XAUTHORITY_FILE:-/run/user/$(id -u)/docker-xwayland.xauth}"

if [ ! -f "${host_xauthority_file}" ]; then
    log "ERROR: XAuthority file not found: ${host_xauthority_file}. Set HOST_XAUTHORITY_FILE to an existing file."
    exit 1
fi

workspace_file="${workspace_dir}/ws.code-workspace"

if [ ! -f "${workspace_file}" ]; then
    log "ERROR: VS Code workspace file not found: ${workspace_file}"
    exit 1
fi

# The Compose file uses an explicit host path because the project may be opened
# from a shell whose current directory is unrelated to the generated workspace.
export HOST_WORKSPACE="${workspace_dir}"
export HOST_XAUTHORITY_FILE="${host_xauthority_file}"
RENDER_GID="$(resolve_render_gid)" || {
    log "ERROR: Failed to read the render-device GID."
    exit 1
}
export RENDER_GID

log "Opening VS Code workspace: ${workspace_file}"
if ! code "${workspace_file}"; then
    log "ERROR: VS Code failed to open ${workspace_file}."
    exit 1
fi
